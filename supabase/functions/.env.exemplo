# Segredos da porta de demonstração (cartão 7gpPBgTH).
#
# Copie para `.env.local`, que é ignorado pelo git, e use com:
#   supabase functions serve --env-file supabase/functions/.env.local
#
# No frila-dev e no frila-prod os mesmos nomes entram por `supabase secrets set`.
#
# DEMONSTRACAO_EMAILS aceita mais de um endereço separado por vírgula: a revisão precisa
# de duas contas, contratante e profissional, porque RN25 dá um perfil por conta.
DEMONSTRACAO_EMAILS=revisao-contratante@frila.app,revisao-profissional@frila.app
DEMONSTRACAO_CODIGO=troque-este-codigo

# Segredo do agendador para as Edge Functions de despacho e push (cartões 7XS6MQGg e 36fU0CEO).
# Obrigatório e sem fallback.
# No frila-dev e frila-prod: supabase secrets set AGENDADOR_SECRET=...
AGENDADOR_SECRET=troque-este-segredo-do-agendador

# Segredos do FCM / Push (cartão 36fU0CEO).
# Conta de serviço do Firebase (Google Cloud IAM) em formato JSON numa linha só,
# ou string codificada em base64. NUNCA commitada no repositório.
# No frila-dev e no frila-prod entra via `supabase secrets set FCM_SERVICE_ACCOUNT='{...}'`.
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"seu-projeto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@seu-projeto.iam.gserviceaccount.com"}

# Provedor de e-mail transacional (cartão 7yq1flLG).
#
# O provedor ainda não foi escolhido — pendência D02 do vault, e o cartão
# `S1 · Infra · SMTP próprio no Supabase Auth`. SMTP é o denominador comum entre os
# candidatos e é o que o Supabase Auth vai usar para o código de entrada; escolhido o
# provedor, entram as credenciais aqui e nada muda no código.
#
# Sem SMTP_HOST e EMAIL_REMETENTE a função responde 500 e **não** arquiva a fila: o
# pendente sai assim que o provedor for configurado.
#
# No frila-dev e no frila-prod: supabase secrets set SMTP_HOST=... SMTP_PASS=...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# `0` desliga o TLS implícito, para apontar o Mailpit local (porta 54325 do inbucket).
SMTP_TLS=1

# O remetente dos e-mails transacionais. Sem ele a função não envia.
EMAIL_REMETENTE=nao-responda@frila.app
# A caixa da Equipe Frila: para onde vão denúncia, contestação e alerta do monitoramento,
# e o Reply-To do protocolo que a pessoa recebe.
EMAIL_EQUIPE=equipe@frila.app
