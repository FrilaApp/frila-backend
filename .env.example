SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Token de conta, para a Management API (criar projeto, aplicar migração remota).
# Alcança TODA a conta do Supabase, não só este projeto. Não precisa no dia a dia.
SUPABASE_ACCESS_TOKEN=

# ── Supabase: frila-dev (ambiente compartilhado)
