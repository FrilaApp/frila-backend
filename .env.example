# Copie para .env e preencha. O .env real nunca entra no git.

# ── Supabase: ambiente local (supabase start imprime estes valores)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Segredo efêmero para o despacho local; deixe vazio até configurar o ambiente.
AGENDADOR_SECRET=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Token de conta, para a Management API (criar projeto, aplicar migração remota).
# Alcança TODA a conta do Supabase, não só este projeto. Não precisa no dia a dia.
SUPABASE_ACCESS_TOKEN=

# ── Supabase: frila-dev (ambiente compartilhado)
# Org "Frila'orgs". A chave de serviço fica fora do app e fora do git: só o agendador
# e a CI a usam. A publicável é a que vai dentro do iOS.
FRILA_DEV_URL=https://jcobftbhbqdikratzizz.supabase.co
FRILA_DEV_ANON_KEY=
FRILA_DEV_SERVICE_ROLE_KEY=
FRILA_DEV_PROJECT_REF=jcobftbhbqdikratzizz

# ── Trello (o pipeline dos cartões)
# Board: https://trello.com/b/0eyqvbRJ/frila
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=6ab2123d15358e7214aa851e

# ── Firebase / FCM (Sprint 2, despacho)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── SMTP do código de entrada (antes do piloto)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=verificacao@frilabr.com
# `0` desliga o TLS implícito, para apontar o Mailpit local.
SMTP_TLS=1

# ── Caixas internas da `enviar-email` (cartão 7yq1flLG)
# Casos de usuário: para onde vão o aviso de denúncia, contestação e revisão de despacho.
# Ausente, vazia ou inválida, a função usa suporte@frilabr.com (nunca o EMAIL_EQUIPE).
EMAIL_CASOS=suporte@frilabr.com
# Caixa da Equipe Frila, só para os alertas técnicos do monitoramento (tipo `alerta`).
# Não recebe caso de usuário e não é o Reply-To ao usuário.
EMAIL_EQUIPE=suporte@frilabr.com
# Reply-To do protocolo que a pessoa recebe: para onde vai a resposta dela. Vazia ou
# inválida, a `enviar-email` usa suporte@frilabr.com (nunca o EMAIL_EQUIPE).
EMAIL_RESPONDER_PARA=suporte@frilabr.com

# ── Demonstração / Revisão da App Store (scripts/semear-vagas-demonstracao.sh)
# Valores padrão do Bar da Revisão e contratante de demonstração.
# O script assume estes valores canônicos se não informados.
EMAIL_CONTRATANTE=revisao-contratante@frilabr.com
ESTABELECIMENTO_BAR_DA_REVISAO=de000000-0000-4000-8000-000000000010
