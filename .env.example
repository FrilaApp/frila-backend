# Copie para .env e preencha. O .env real nunca entra no git.

# ── Supabase: ambiente local (supabase start imprime estes valores)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase: frila-dev (ambiente compartilhado)
# A chave de serviço fica fora do app e fora do git. Só o agendador e a CI a usam.
FRILA_DEV_URL=
FRILA_DEV_ANON_KEY=
FRILA_DEV_SERVICE_ROLE_KEY=
FRILA_DEV_PROJECT_REF=

# ── Trello (o pipeline dos cartões)
# Board: https://trello.com/b/0eyqvbRJ/frila
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=6ab2123d15358e7214aa851e

# ── Firebase / FCM (Sprint 2, despacho)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── SMTP do código de entrada (antes do piloto)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=nao-responda@frila.app
